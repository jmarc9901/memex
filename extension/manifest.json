{
  "manifest_version": 3,
  "name": "Memex Offline - Guardar pagina",
  "version": "0.1.0",
  "description": "Guarda la pagina actual (o la seleccion) en tu indice local de Memex Offline. Sin nube.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardar en Memex Offline"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
